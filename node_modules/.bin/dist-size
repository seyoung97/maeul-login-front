#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/seyoungchung/projects/maeul-login-front/node_modules/.pnpm/dist-size@0.4.0/node_modules/dist-size/node_modules:/Users/seyoungchung/projects/maeul-login-front/node_modules/.pnpm/dist-size@0.4.0/node_modules:/Users/seyoungchung/projects/maeul-login-front/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/seyoungchung/projects/maeul-login-front/node_modules/.pnpm/dist-size@0.4.0/node_modules/dist-size/node_modules:/Users/seyoungchung/projects/maeul-login-front/node_modules/.pnpm/dist-size@0.4.0/node_modules:/Users/seyoungchung/projects/maeul-login-front/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.pnpm/dist-size@0.4.0/node_modules/dist-size/cli.js" "$@"
else
  exec node  "$basedir/../.pnpm/dist-size@0.4.0/node_modules/dist-size/cli.js" "$@"
fi
